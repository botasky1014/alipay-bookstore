# Copy this file to .env and fill in the values.

# Database
DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=bookstore

# Alipay sandbox (public key mode, RSA2).
# The notify URL and return URL are set by the admin on the Settings page, not here.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_TIMEOUT_EXPRESS=2h
